<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="uz.ustapro">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
    <application android:label="USTA PRO" android:icon="@drawable/app_icon" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <provider android:name=".CameraProvider" android:authorities="uz.ustapro.camera"
            android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ustapro" android:host="signin"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
